@model RedefinirSenhaModel;
@{
    Layout = "_LayoutDeslogada";
    ViewData["Title"] = "Redefinir Senha";
}

<form asp-controller="Login" asp-action="RedefinirSenha" method="post">
    <div class="form-group">
        <label for="login">Login</label>
        <input type="text" asp-for="Login" class="form-control" id="login" aria-describedby="emailHelp">
        @Html.ValidationMessageFor(x => x.Login)
    </div>
    <div class="form-group mt-3">
        <label for="email">Email</label>
        <input type="text" asp-for="Email" class="form-control" id="email">
        @Html.ValidationMessageFor(x => x.Email)
    </div>
    <div class="d-flex column-gap-4 align-items-center">
        <a class="btn btn-secondary btn-block" asp-action="Index" asp-controller="Login">Voltar</a>
        <button type="submit" class="btn btn-primary my-3 d-block">Redefinir Senha</button>
    </div>
</form>


