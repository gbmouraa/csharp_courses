@model LoginModel;
@{
    Layout = "_LayoutDeslogada";
    ViewData["Title"] = "Login";
}

<form asp-controller="Login" asp-action="Login" method="post">
    <div class="form-group">
        <label for="login">Login</label>
        <input type="text" asp-for="Login" class="form-control" id="login" aria-describedby="emailHelp">
        @Html.ValidationMessageFor(x => x.Login)
    </div>
    <div class="form-group mt-3">
        <label for="password">Senha</label>
        <input type="password" asp-for="Senha" class="form-control" id="senha">
        @Html.ValidationMessageFor(x => x.Senha)
    </div>
    <div>
        <button type="submit" class="btn btn-primary my-3 d-block">Entrar</button>
        <a class="text-primary fs-6" asp-action="RedefinirSenha" asp-controller="Login">Esqueci minha senha</a>
    </div>
</form>

